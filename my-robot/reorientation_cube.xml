<mujoco model="cube_56mm">
  <!-- 56x56x56mm 정육면체 (3x3 스피드큐브 규격)
       x,y 슬라이드 조인트만 있어서 높이(z)와 회전은 고정,
       중력에 의한 낙하 없이 바닥에 놓인 것처럼 위치만 바뀜.
       z=-0.08m: 4손가락이 완전히 오므렸을 때 손끝이 모이는 실측 높이
       (mesh/텍스처 파일 의존성 없음) -->
  <default>
    <default class="cube">
      <geom friction="1.0 0.01 0.001" conaffinity="2" condim="4"/>
    </default>
  </default>

  <worldbody>
    <body name="cube" pos="0 0 -0.08" quat="1 0 0 0" childclass="cube">
      <joint name="cube_slide_x" type="slide" axis="1 0 0" damping="0.5"/>
      <joint name="cube_slide_y" type="slide" axis="0 1 0" damping="0.5"/>
      <geom name="cube" type="box" size="0.028 0.028 0.028" mass="0.07"
            group="2" rgba="0.85 0.15 0.15 1"/>
      <site name="cube_center" pos="0 0 0" group="4" size="0.001"/>
    </body>
  </worldbody>
</mujoco>
