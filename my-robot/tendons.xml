<tendon>
    <fixed name="right_finger_tendon">
        <joint joint="right-body-link1" coef="1.0"/>
        <joint joint="right-link1-joint" coef="1.0"/>
        <joint joint="right-joint-joint" coef="1.0"/>
        <joint joint="right-joint-link2" coef="1.0"/>
    </fixed>
    <fixed name="front_finger_tendon">
        <joint joint="front-body-link1" coef="1.0"/>
        <joint joint="front-link1-joint" coef="1.0"/>
        <joint joint="front-joint-joint" coef="1.0"/>
        <joint joint="front-joint-link2" coef="1.0"/>
    </fixed>
    <fixed name="left_finger_tendon">
        <joint joint="left-body-link1" coef="1.0"/>
        <joint joint="left-link1-joint" coef="1.0"/>
        <joint joint="left-joint-joint" coef="1.0"/>
        <joint joint="left-joint-link2" coef="1.0"/>
    </fixed>
    <fixed name="back_finger_tendon">
        <joint joint="back-body-link1" coef="1.0"/>
        <joint joint="back-link1-joint" coef="1.0"/>
        <joint joint="back-joint-joint" coef="1.0"/>
        <joint joint="back-joint-link2" coef="1.0"/>
    </fixed>
</tendon>

<!-- Position-servo actuators: ctrl is the target tendon length (== target
     motor rotation, gear=1), matching a real motor driver that only takes
     a position setpoint. kp/dampratio implement the PD loop a real
     position servo/driver performs internally. ctrlrange per finger =
     sum of that finger's joint ranges (tendon coef is 1.0 on each). -->
<actuator>
    <position name="right_finger_motor" tendon="right_finger_tendon" kp="50" dampratio="1" ctrlrange="-0.0873 2.0071"/>
    <position name="front_finger_motor" tendon="front_finger_tendon" kp="50" dampratio="1" ctrlrange="0.0 2.0944"/>
    <position name="left_finger_motor" tendon="left_finger_tendon" kp="50" dampratio="1" ctrlrange="-0.0441 2.0503"/>
    <position name="back_finger_motor" tendon="back_finger_tendon" kp="50" dampratio="1" ctrlrange="0.0 2.0944"/>
</actuator>